rules_version = '2';

// MyWallet Fase 1 (v1.17) + sync beta (v1.19) — Google Sign-In + rumah.
//
// Model:
// - households/{hid}: {name, createdBy, inviteCode, ...} — baca/tulis
//   HANYA anggota (dok members/{uid} miliknya ADA).
// - households/{hid}/members/{uid}: anggota kelola SENDIRI (gabung via
//   kode = tulis diri sendiri; keluar = hapus diri sendiri; owner bisa
//   hapus anggota lain). Update role hanya owner (cek role pemohon).
// - invites/{CODE}: {householdId, householdName, ...} = capability
//   secret (kayak link join grup).
//   Semua user LOGIN bisa `get` BILA tahu kodenya (tidak bisa list).
//   Tulis: user login (buat/putar kode milik rumah tangganya).
// - users/{uid}: profil milik SENDIRI saja.
// - Sync beta v1.19: koleksi cats + tx di bawah tiap household,
//   anggota-only, tulis wajib updatedBy = uid sendiri, hapus fisik
//   ditolak (pakai tombstone deletedAt).
//
// Catatan: get((...)).data = baca 1 dokumen (bayar 1 read, bukan list).
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isMember(hid) {
      return signedIn()
        && exists(/databases/$(database)/documents/households/$(hid)/members/$(request.auth.uid));
    }

    function isOwner(hid) {
      return isMember(hid)
        && get(/databases/$(database)/documents/households/$(hid)/members/$(request.auth.uid)).data.role == 'owner';
    }

    // ---- Rumah tangga: hanya anggota ----
    match /households/{hid} {
      allow get: if isMember(hid);
      // Buat: pemohon otomatis jadi owner (dicek auth_service batch).
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid;
      // Update nama/kode: hanya owner.
      allow update: if isOwner(hid);
      allow delete: if false; // hapus via console saja.

      match /members/{uid} {
        // Daftar anggota: hanya anggota (privasi email).
        allow list, get: if isMember(hid);
        // Gabung: tulis DOKUMEN DIRI SENDIRI saja (role member/owner).
        allow create: if signedIn()
          && uid == request.auth.uid
          && (request.resource.data.role == 'member'
            || request.resource.data.role == 'owner');
        // Ubah role: hanya owner (naik/turun peran).
        allow update: if isOwner(hid);
        // Keluar: hapus DIRI SENDIRI. Owner boleh hapus anggota LAIN
        // (kick) — dipakai dialog Kelola anggota di app.
        allow delete: if signedIn()
          && (uid == request.auth.uid || isOwner(hid));
      }

      // Sync transaksi + kategori Fase 2 beta (v1.19): anggota rumah.
      // Cermin utang TIDAK ditulis mentah (rebuild per-HP Fase 3) —
      // service tidak pernah push debtId, ini lapis pertahanan kedua.
      match /tx/{doc} {
        allow read: if isMember(hid);
        allow create, update: if isMember(hid)
          && request.resource.data.updatedBy == request.auth.uid
          && (!('debtId' in request.resource.data)
            || request.resource.data.debtId == null);
        allow delete: if false; // hapus = tombstone deletedAt, bukan hapus.
      }
      match /cats/{doc} {
        allow read: if isMember(hid);
        allow create, update: if isMember(hid)
          && request.resource.data.updatedBy == request.auth.uid;
        allow delete: if false;
      }
    }

    // ---- Invite: get-per-kode untuk user login (tanpa list) ----
    match /invites/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create, update: if signedIn();
      allow delete: if false;
    }

    // ---- Profil: milik sendiri ----
    match /users/{uid} {
      allow get: if signedIn() && uid == request.auth.uid;
      allow create, update: if signedIn() && uid == request.auth.uid;
      allow delete: if false;
    }
  }
}
